[Unit]
Description=PhysioVision Download Server
After=network.target

[Service]
Type=simple
User=wideindeed
WorkingDirectory=/home/wideindeed/physiovision-dl
Environment=TURNSTILE_SECRET_KEY=your_turnstile_secret_here
Environment=EXE_SHA256=paste_sha256_hash_here
Environment=TOKEN_SECRET=run_python3_-c_"import secrets;print(secrets.token_hex(32))"_and_paste_here
ExecStart=/home/wideindeed/physiovision-dl/venv/bin/uvicorn server:app --host 127.0.0.1 --port 8090
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
